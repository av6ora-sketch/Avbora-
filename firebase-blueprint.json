{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing skills and level.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "age": { "type": "number", "description": "User age" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "subscriptionPlan": { "type": "string", "enum": ["Free", "Pro"] },
        "balance": { "type": "number", "description": "User earnings balance" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["name", "email", "createdAt"]
    },
    "Job": {
      "title": "Job",
      "description": "Job or project opportunity.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["permanent", "temporary", "freelance"] },
        "skillsRequired": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["title", "description", "type", "createdAt"]
    },
    "Scholarship": {
      "title": "Scholarship",
      "description": "Scholarship opportunity.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "country": { "type": "string" },
        "requirements": { "type": "string" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["title", "country", "createdAt"]
    },
    "MarketplaceItem": {
      "title": "Marketplace & Auctions",
      "description": "Products and services for sale or auction.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startingPrice": { "type": "number" },
        "currentBid": { "type": "number" },
        "highestBidderId": { "type": "string" },
        "highestBidderName": { "type": "string" },
        "imageUrl": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "ended"] },
        "endTime": { "type": "string", "format": "timestamp" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["title", "description", "startingPrice", "sellerId", "status", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Community post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["portfolio", "hiring", "buying", "general"] },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "likes": { "type": "array" },
        "comments": { "type": "array" },
        "sharesCount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "content", "createdAt"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "Support ticket.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "pending"] },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "subject", "message", "status", "createdAt"]
    },
    "MicroTask": {
      "title": "MicroTask",
      "description": "Small task for users to earn money.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "reward": { "type": "number" },
        "url": { "type": "string" },
        "type": { "type": "string", "enum": ["survey", "visit", "data-entry", "testing", "other"] },
        "proofType": { "type": "string", "enum": ["screenshot", "code", "text"] },
        "visitsGoal": { "type": "number", "description": "Target number of visits for visit-type tasks" },
        "currentVisits": { "type": "number", "description": "Current number of clicks/visits recorded" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["title", "reward", "url", "type", "proofType", "status", "createdAt"]
    },
    "TaskSubmission": {
      "title": "TaskSubmission",
      "description": "Submission of a microtask for review.",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "taskTitle": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "proof": { "type": "string", "description": "Text proof or completion code" },
        "screenshotUrl": { "type": "string", "description": "Base64 or URL of the proof screenshot" },
        "reward": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["taskId", "userId", "status", "createdAt"]
    },
    "ConnectedBlog": {
      "title": "ConnectedBlog",
      "description": "A user's connected Blogger blog for auto-publishing.",
      "type": "object",
      "properties": {
        "blogId": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "autoPublish": { "type": "boolean", "description": "Enable auto-publishing for this blog." },
        "keywords": { "type": "string", "description": "Target keywords for AI generation." },
        "topic": { "type": "string", "description": "Primary topic of the blog." },
        "language": { "type": "string", "description": "Language for the articles (e.g., Arabic, English)." },
        "tone": { "type": "string", "description": "The tone of voice for AI (e.g., Professional, Informative, Casual)." },
        "schedule": { "type": "string", "description": "Interval for auto-publishing (e.g., Daily, Weekly)." }
      },
      "required": ["blogId", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Stores user profiles."
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "Job" },
      "description": "Stores job and project opportunities."
    },
    "/scholarships/{scholarshipId}": {
      "schema": { "$ref": "Scholarship" },
      "description": "Stores scholarships."
    },
    "/marketplace/{itemId}": {
      "schema": { "$ref": "MarketplaceItem" },
      "description": "Stores marketplace and auction items."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "Post" },
      "description": "Stores community posts."
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "Ticket" },
      "description": "Stores support tickets."
    },
    "/microtasks/{taskId}": {
      "schema": { "$ref": "MicroTask" },
      "description": "Stores microtasks for users."
    },
    "/task_submissions/{submissionId}": {
      "schema": { "$ref": "TaskSubmission" },
      "description": "Stores user submissions for microtasks."
    },
    "/user_blogs/{blogDocId}": {
      "schema": { "$ref": "ConnectedBlog" },
      "description": "Stores user connected Blogger blogs."
    },
    "/articles/{articleId}": {
      "schema": {
        "title": "Article",
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "blogId": { "type": "string" },
          "blogName": { "type": "string" },
          "userId": { "type": "string" },
          "status": { "type": "string" },
          "bloggerUrl": { "type": "string" },
          "createdAt": { "type": "string", "format": "timestamp" }
        },
        "required": ["title", "blogId", "userId", "status", "createdAt"]
      },
      "description": "Stores AI-generated and published articles record."
    }
  }
}
